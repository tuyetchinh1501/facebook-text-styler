{
  "manifest_version": 3,
  "name": "Premium Facebook Text Styler",
  "version": "1.0.0",
  "description": "Convert text into premium Unicode styles for Facebook and social media.",
  "action": {
    "default_title": "Text Styler",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "permissions": [
    "clipboardWrite",
    "sidePanel",
    "storage"
  ]
}
